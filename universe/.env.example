# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1          # use 0.0.0.0 only when deploying behind a proxy/firewall
PORT=3000
TRUST_PROXY=false       # true only when behind exactly one reverse proxy
ALLOWED_ORIGINS=        # extra comma-separated origins allowed to call the API (usually empty)

# Storage layer: "sqlite" now; a home-server driver can be added later
STORAGE_DRIVER=sqlite   # or "github" to keep data as JSON in a PRIVATE GitHub repo (README section 11b)
SQLITE_PATH=./data/universe.db

SESSION_TTL_HOURS=168

# First admin, created ONLY when the database has no users. Remove the password after first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- AI (Phase 5) ----
# Encrypts users' own API keys at rest. REQUIRED to let users store personal keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=
AI_DEFAULT_PROVIDER=groq
# Use a current model id from your provider's docs (names change). Admins can also set this in the UI.
AI_DEFAULT_MODEL=
# The ecosystem owner's shared key. Server-side only, never sent to browsers.
GROQ_API_KEY=

# ---- Cloudinary (Phase 4). Only the cloud name and unsigned preset are used; both are public values ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Reserved for a later signed-upload upgrade. NEVER put in frontend code. Not used yet.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- github storage driver (only when STORAGE_DRIVER=github) ----
GITHUB_TOKEN=           # fine-grained token, ONE repo, Contents: read and write
GITHUB_REPO=            # owner/name of a PRIVATE repo
GITHUB_BRANCH=universe-data
GITHUB_DATA_PATH=universe-data.json
