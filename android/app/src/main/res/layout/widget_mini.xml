<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/p_art" android:layout_width="46dp" android:layout_height="46dp" android:scaleType="centerCrop" android:src="@drawable/art_placeholder" android:contentDescription="Album art" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/p_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/p_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A6A6A6" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageView android:id="@+id/p_prev" android:layout_width="34dp" android:layout_height="34dp" android:padding="7dp" android:src="@drawable/ic_prev" android:tint="#FFFFFF" android:contentDescription="p_prev" />
    <ImageView android:id="@+id/p_play" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:background="@drawable/btn_circle" android:src="@drawable/ic_play" android:tint="#000000" android:contentDescription="p_play" />
    <ImageView android:id="@+id/p_next" android:layout_width="34dp" android:layout_height="34dp" android:padding="7dp" android:src="@drawable/ic_next" android:tint="#FFFFFF" android:contentDescription="p_next" />
</LinearLayout>
